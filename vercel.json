{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/WW_verify_(.*)", "dest": "/web/WW_verify_$1" },
    { "src": "/(.*)", "dest": "/web/$1" }
  ]
}
