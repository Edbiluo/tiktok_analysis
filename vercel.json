{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python@4.3.1"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/WW_verify_icUqTWqVPjBjx5sl.txt", "dest": "/api/WW_verify_icUqTWqVPjBjx5sl" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
